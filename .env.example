# Server-only Resend API key. Never prefix this variable with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives new export enquiries.
CONTACT_TO_EMAIL=

# Verified Resend sender, for example "Biswas Exports <enquiries@example.com>".
CONTACT_FROM_EMAIL=

# Public contact details displayed on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# WhatsApp number in international format, including country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=
