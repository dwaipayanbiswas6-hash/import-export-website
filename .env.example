# -----------------------------------------------------------------------------
# Production URL and indexing
# -----------------------------------------------------------------------------
# Final public origin with https and no trailing slash.
NEXT_PUBLIC_SITE_URL=

# Keep false for local development and Vercel previews.
# Set true only after the final production portal and enquiry tests pass.
NEXT_PUBLIC_ALLOW_INDEXING=false

# -----------------------------------------------------------------------------
# Supabase buyer portal
# -----------------------------------------------------------------------------
# Project URL and publishable key are safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS and must never use the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated business emails allowed to open /admin/enquiries.
PORTAL_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Optional Resend notifications — server only
# -----------------------------------------------------------------------------
# Enquiries and messages are stored in Supabase even when these are blank.
# Resend only provides admin alerts and buyer response notifications.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_REPLY_TO_EMAIL=

# -----------------------------------------------------------------------------
# Public contact details — exposed in the browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# WhatsApp number in international format, including country code.
# Example format only: +919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Avoid a guaranteed deadline. Example:
# Most complete business enquiries are reviewed within 1–2 business days.
NEXT_PUBLIC_CONTACT_RESPONSE_TIME=

# -----------------------------------------------------------------------------
# Optional verified business disclosure
# -----------------------------------------------------------------------------
# Leave blank until the exact wording is approved and supported by records.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_REGISTRATION_LINE=
